# Select one: native_server, local_server, test
APP_MODE=local_server

# Shared RSS settings
RSS_URL=https://www.nhk.or.jp/rss/news/cat5.xml
RSS_USER_AGENT=NewsDataDir/1.0
RSS_POLL_SECONDS=900
RSS_JITTER_SECONDS=20
RSS_OUTPUT_CSV=news_data.csv

# Native server mode: collect RSS and automatically infer on either trigger.
# Set NATIVE_TRIGGER_ON_UPDATE=false to wait for the batch threshold instead.
NATIVE_TRIGGER_ON_UPDATE=true
NATIVE_TRIGGER_NEWS_COUNT=10
NATIVE_PROCESSING_CSV=processing_news_data.csv
NATIVE_SEEN_URLS_FILE=.news_seen_urls.txt

# Local server mode: run inference once when main.py is started.
# Use "ssh" for an external collector, or "local" for a local CSV file.
LOCAL_SERVER_SOURCE=ssh
LOCAL_SERVER_SSH_HOST=user@news-server
LOCAL_SERVER_REMOTE_CSV=/mnt/usb1/news_data.csv
LOCAL_SERVER_REMOTE_PROCESSING_CSV=/mnt/usb1/processing.csv
LOCAL_SERVER_INPUT_CSV=news_data.csv
LOCAL_SERVER_PROCESSING_CSV=processing_news_data.csv

# Test mode: fetch this many RSS entries, infer once, and append matching results.
TEST_RSS_NEWS_COUNT=5

# Shared inference settings. Keep actual credentials in .env, never commit them.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
STOCK_DATA_CSV=data_j.csv
FILTERED_OUTPUT_CSV=filtered_news_stocks.csv
CUT_PRICE=500
PRICE_LOOKUP_DELAY=0.5
